{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_C_COMPILER=C:/TDM-GCC-64/bin/x86_64-w64-mingw32-gcc.exe",
                "-DCMAKE_CXX_COMPILER=C:/TDM-GCC-64/bin/x86_64-w64-mingw32-g++.exe",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "dependsOn": "configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build & run",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-c",
                    "& .\\output\\vybn.exe"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "./output/vybn"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "./output/vybn"
                ]
            },
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "test",
            "type": "shell",
            "command": "bash",
            "args": [
                "tools/test.sh"
            ],
            "dependsOn": "build",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "test (full)",
            "type": "shell",
            "command": "bash",
            "args": [
                "tools/test.sh",
                "--full"
            ],
            "dependsOn": "build",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "build",
                "output"
            ],
            "problemMatcher": []
        }
    ]
}
